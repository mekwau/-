# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional n8n Webhook Base URL (leave empty to use local Demo Mode & server-side Gemini fallback)
VITE_N8N_WEBHOOK_BASE_URL=""

# Optional Supabase public client configuration (for production auth/database integration)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
